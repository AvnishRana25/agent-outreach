# Claude API key (console.anthropic.com). About $2/day for 38 sequences on the default model.
ANTHROPIC_API_KEY=
# Optional: override the model, e.g. claude-sonnet-5-5 to cut cost by about half
# OUTREACH_MODEL=claude-opus-5-5

# App passwords for each inbox named in config/settings.yaml (password_env)
# Gmail: myaccount.google.com/apppasswords (needs 2-step verification)
# Zoho: Settings > Security > App passwords
GMAIL_APP_PASSWORD=
INBOX1_PASSWORD=
INBOX2_PASSWORD=
INBOX3_PASSWORD=
INBOX4_PASSWORD=

# Optional: phone alert for every positive reply (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
