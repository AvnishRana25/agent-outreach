# Gemini API key, free at https://aistudio.google.com/apikey (no card needed).
# Free-tier prompts may be used by Google to improve its products; don't paste private data.
GEMINI_API_KEY=
# Models (free-tier availability changes; check AI Studio -> Rate limits)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_RESEARCH_MODEL=gemini-2.5-flash
# GEMINI_REPLY_MODEL=gemini-2.5-flash-lite
# Requests per minute to stay under (free flash is ~10 RPM)
# GEMINI_RPM=9

# Gmail: app password from myaccount.google.com/apppasswords (needs 2-step verification)
GMAIL_APP_PASSWORD=

# Zoho Mail REST API (only if `python -m outreach zoho-check` succeeds on your plan)
# Create a Self Client at https://api-console.zoho.in (or .com), scopes:
#   ZohoMail.accounts.READ,ZohoMail.messages.ALL,ZohoMail.folders.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Only for a paid Zoho plan with SMTP/IMAP enabled:
ZOHO_APP_PASSWORD=

# Optional: phone alert for every positive reply (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Extra prospect sources (all optional) -------------------------------------------------
# UK Companies House (free): developer.company-information.service.gov.uk -> create an
# application -> "REST" API key. Used by the companies_house source (UK agencies + director names).
COMPANIES_HOUSE_API_KEY=
# Reddit (free "script" app at reddit.com/prefs/apps). Without it, the public RSS feeds are used.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Apify (free account, $5/month credit) for the apify_maps source. Off by default in settings.yaml.
APIFY_TOKEN=
