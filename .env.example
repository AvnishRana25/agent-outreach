# Gemini API key, free at https://aistudio.google.com/apikey (no card needed).
# Free-tier prompts may be used by Google to improve its products; don't paste private data.
GEMINI_API_KEY=
# Backup AI when Gemini is out of quota or overloaded (free key: console.groq.com/keys). Optional.
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant
# Models. Each model has its own small free daily quota, so every kind of call walks a chain and
# moves to the next model when one is used up (see outreach/llm.py CHAINS). Override a chain with a
# comma-separated list, or put one model first with GEMINI_MODEL / GEMINI_RESEARCH_MODEL / GEMINI_REPLY_MODEL.
# GEMINI_RESEARCH_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash-lite
# GEMINI_DRAFT_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest
# GEMINI_REPLY_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
# Requests per minute to stay under (free flash is ~10 RPM)
# GEMINI_RPM=9

# Gmail: app password from myaccount.google.com/apppasswords (needs 2-step verification)
GMAIL_APP_PASSWORD=

# Zoho Mail REST API (only if `python -m outreach zoho-check` succeeds on your plan)
# Create a Self Client at https://api-console.zoho.in (or .com), scopes:
#   ZohoMail.accounts.READ,ZohoMail.messages.ALL,ZohoMail.folders.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Only for a paid Zoho plan with SMTP/IMAP enabled:
ZOHO_APP_PASSWORD=

# Optional: phone alert for every positive reply and every relevant community post.
# Create a bot with @BotFather, message it once, then `python -m outreach telegram-setup`
# prints the numeric chat id (a @username does not work for private chats).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firecrawl (firecrawl.dev): fallback website reader + page finder + company-site search.
# Daily credit use is capped by `firecrawl.daily_credit_cap` in settings.yaml.
FIRECRAWL_API_KEY=
# Only for a self-hosted Firecrawl (docker); leave unset for the hosted API.
# FIRECRAWL_API_URL=http://localhost:3002

# --- Extra prospect sources (all optional) -------------------------------------------------
# UK Companies House (free): developer.company-information.service.gov.uk -> create an
# application -> "REST" API key. Used by the companies_house source (UK agencies + director names).
COMPANIES_HOUSE_API_KEY=
# Reddit Data API: request approval at https://support.reddithelp.com/hc/en-us/requests/new?ticket_form_id=14868593862164
# Until approved, check Reddit boards manually; the engine does not scrape or fetch public RSS.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Descriptive format, e.g. macos:agent-outreach:v1.0 (by /u/your_username)
REDDIT_USER_AGENT=
# Apify (free account, $5/month credit) for the apify_maps source. Off by default in settings.yaml.
APIFY_TOKEN=

# --- Environment & Storage -------------------------------------------------------------
# 'local' uses local SQLite (data/outreach.db). 'production' uses remote Turso libSQL.
OUTREACH_ENV=local

# --- Dashboard & Remote Database (Turso) ------------------------------------------------
# Turso (free hosted SQLite): stores persistent state in production and feeds the Vercel dashboard.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Only needed to run the dashboard locally (`python -m outreach dashboard`); on Vercel set them
# in Project -> Settings -> Environment Variables instead.
DASHBOARD_PASSWORD=
SESSION_SECRET=
# Local dashboard port (default 7347). Change it if another app already uses it.
# DASHBOARD_PORT=7347

# GitHub "good first issue" lead source (optional, free; any token with no scopes)
# GITHUB_TOKEN=
