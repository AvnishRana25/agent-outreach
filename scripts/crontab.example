# Not needed on a Mac: `python -m outreach install` sets up the background engine with launchd.
# Linux: one line runs everything (sending, replies, community, the daily prepare, dashboard sync).
# Install with `crontab -e` and fix the path.
*/5 * * * * cd /home/YOU/agent-outreach && .venv/bin/python -m outreach tick >> data/engine.log 2>&1

# Nightly backup of the database
55 23 * * * cp /home/YOU/agent-outreach/data/outreach.db /home/YOU/agent-outreach/data/outreach.$(date +\%a).db
